{
    "name": "vmstudio/vm-sales-os",
    "description": "Enterprise AI sales, CRM and automation platform for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "wp-coding-standards/wpcs": "^3.0",
        "squizlabs/php_codesniffer": "^3.9",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "VMStudio\\SalesOS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VMStudio\\SalesOS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist",
        "fix": "phpcbf --standard=phpcs.xml.dist",
        "analyse": "phpstan analyse src --level=6",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
